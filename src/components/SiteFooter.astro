<style>
  /* Full-width element; inner content follows the site's max-width + padding */
  .site-footer {
    width: 100%;
  }

  .footer-content {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 48px;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 11px 0 4px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: var(--muted);
    gap: 24px;
    border-top: 1px solid var(--line);
  }

  .footer-inner strong { color: var(--fg); font-weight: 600; }

  .footer-links {
    display: flex;
    gap: 20px;
    flex-shrink: 0;
  }

  .footer-link {
    color: var(--muted);
    border-bottom: 1px solid var(--line);
    padding-bottom: 1px;
    text-decoration: none;
    transition: color 120ms, border-color 120ms;
  }

  .footer-link:hover {
    color: var(--fg);
    border-bottom-color: var(--fg);
  }

  .footer-prado {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.04em;
    color: var(--muted-2);
    padding-bottom: 14px;
  }

  @media (max-width: 600px) {
    .footer-content { padding: 0 20px; }
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
    .footer-links { gap: 14px; }
  }
</style>
