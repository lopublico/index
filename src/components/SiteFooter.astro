---
import Marca from './Marca.astro';
---

<footer class="lo-footer">
  <div class="lo-footer-inner">

    <div class="lo-footer-social">
      <a rel="me" href="https://masto.es/@lopublico.es@bsky.brid.gy" class="lo-footer-link" target="_blank" title="@lopublico en Mastodon">Mastodon<span class="sr-only"> (abre en nueva pestaña)</span></a> · <a href="https://bsky.app/profile/lopublico.es" class="lo-footer-link" target="_blank" rel="noopener" title="@lopublico.es en Bluesky">Bluesky<span class="sr-only"> (abre en nueva pestaña)</span></a>
    </div>

    <div class="lo-footer-right">
      <span>Por <a href="https://avelrom.es/about/" class="lo-footer-link" target="_blank" rel="noopener">avelrom</a></span>
      <a href="https://creativecommons.org/publicdomain/zero/1.0/deed.es" class="lo-footer-license" target="_blank" rel="noopener license" title="Licencia de dominio público Creative Commons Zero 1.0">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.5"/>
          <text x="10" y="14.5" text-anchor="middle" font-size="7.5" font-weight="700" fill="currentColor" font-family="system-ui,sans-serif">CC</text>
        </svg>
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.5"/>
          <text x="10" y="14.5" text-anchor="middle" font-size="7.5" font-weight="700" fill="currentColor" font-family="system-ui,sans-serif">0</text>
        </svg>
        <span>1.0</span>
      </a>
    </div>

  </div>
  <div class="lo-footer-prado">
    Obras del © <a href="https://www.museodelprado.es/" target="_blank" rel="noopener">Museo Nacional del Prado</a>.
  </div>
</footer>

<style>
  .lo-footer {
    border-top: 1px solid var(--line);
  }

  .lo-footer-inner {
    max-width: 1320px;
    margin: 0 auto;
    padding: 24px 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }

  .lo-footer-right {
    display: flex;
    align-items: center;
    gap: 20px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .lo-footer-link {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }

  .lo-footer-license {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: inherit;
    text-decoration: none;
    opacity: 0.75;
  }

  .lo-footer-license:hover { opacity: 1; }

  .lo-footer-prado {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 48px 14px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.04em;
    color: var(--muted-2);
  }

  .lo-footer-prado a {
    color: inherit;
    text-decoration: underline;
  }

  @media (max-width: 600px) {
    .lo-footer-inner  { padding: 20px; }
    .lo-footer-prado  { padding: 0 20px 14px; }
  }
</style>
