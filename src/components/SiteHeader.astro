---
interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;

const navLinks = [
  { href: '/',             label: 'Inicio' },
  { href: '/acerca',       label: 'Sobre Lo Público' },
  { href: '/metodologia',  label: 'Metodología' },
];
---

<header class="site-header">
  <div class="tool-title-row">
    <div class="tool-logo" aria-hidden="true">
      <img src="/logos/logo0.png" alt="">
    </div>
    <div class="tool-title-text">
      <a href="/" class="tool-title-name">Lo público.</a>
      <span class="tool-title-parent">La Administración, en datos</span>
    </div>
  </div>

  <nav class="site-nav" aria-label="Navegación principal">
    {navLinks.map(link => (
      <a
        href={link.href}
        class={`nav-link${currentPath === link.href ? ' nav-link--active' : ''}`}
      >
        {link.label}
      </a>
    ))}
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: 24px 0 20px;
    position: relative;
  }

  .tool-title-row {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .tool-logo {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
  }

  .tool-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 4px;
  }

  .tool-title-text {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 44px;
    padding-left: 12px;
    border-left: 1px solid var(--line);
  }

  .tool-title-name {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 22px;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--fg);
    text-decoration: none;
  }

  .tool-title-parent {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 15px;
    line-height: 1;
    color: var(--muted);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-link {
    padding: 5px 10px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 400;
    text-decoration: none;
    color: var(--fg-2);
    border-radius: 4px;
    transition: color 120ms, background 120ms;
    white-space: nowrap;
  }
  .nav-link:hover { color: var(--fg); background: rgba(0, 0, 0, 0.05); }
  .nav-link--active { color: var(--fg); font-weight: 600; }

  /* ── Responsive ───────────────────────────────────────────────────────── */
  @media (max-width: 600px) {
    .site-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
      padding: 18px 0 14px;
    }
    .tool-title-text { display: none; }
    .site-nav { gap: 2px; }
  }
</style>
