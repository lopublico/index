---
import Marca from './Marca.astro';

interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;

const navLinks = [
  { href: '/',             label: 'Inicio' },
  { href: '/acerca',       label: 'Sobre Lo Público' },
  { href: '/metodologia',  label: 'Metodología' },
];
---

<header class="site-header">
  <Marca variant="header" href="/" />

  <nav class="site-nav" aria-label="Navegación principal">
    {navLinks.map(link => (
      <a
        href={link.href}
        class={`nav-link${currentPath === link.href ? ' nav-link--active' : ''}`}
      >
        {link.label}
      </a>
    ))}
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: 24px 0 20px;
    position: relative;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-link {
    padding: 5px 10px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 400;
    text-decoration: none;
    color: var(--fg-2);
    border-radius: 4px;
    transition: color 120ms, background 120ms;
    white-space: nowrap;
  }
  .nav-link:hover { color: var(--fg); background: rgba(0, 0, 0, 0.05); }
  .nav-link--active { color: var(--fg); font-weight: 600; }

  /* ── Responsive ───────────────────────────────────────────────────────── */
  @media (max-width: 600px) {
    .site-header {
      flex-wrap: wrap;
      gap: 12px 0;
      padding: 18px 0 14px;
    }
    .site-nav { gap: 2px; width: 100%; }
  }
</style>
