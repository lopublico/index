---
import Marca from './Marca.astro';
import { getEntradasBlog } from '../data/blog';

interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;

// «Blog» solo existe si hay alguna entrada de avelrom.es etiquetada «lopublico»
const hayBlog = (await getEntradasBlog()).length > 0;
const navLinks = [
  { href: '/',      label: 'Inicio' },
  { href: '/datos',  label: 'Datos' },
  ...(hayBlog ? [{ href: '/blog', label: 'Blog' }] : []),
  { href: '/about',  label: 'About' },
];
---

<header class="site-header">
  <Marca variant="header" href="/" />

  <nav class="site-nav" aria-label="Navegación principal">
    <div class="nav-links">
      {navLinks.map(link => {
        const isActive = currentPath === link.href;
        return (
          <a
            href={link.href}
            class={`nav-link${isActive ? ' nav-link--active' : ''}`}
          >
            {link.label}
            {isActive && <span class="nav-active-line" transition:name="nav-active-line" />}
          </a>
        );
      })}
    </div>

    <span class="nav-separator" aria-hidden="true" />

    <div class="nav-social" aria-label="Redes sociales">
      <a
        href="https://masto.es/@lopublico.es@bsky.brid.gy"
        class="nav-social-link"
        target="_blank"
        rel="me noopener"
        title="Mastodon (@lopublico)"
        aria-label="Mastodon (@lopublico)"
      >
        <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
          <path d="M23.268 5.313c-.35-2.578-2.617-4.61-5.304-5.004C17.51.242 15.792 0 11.813 0h-.03c-3.98 0-4.835.242-5.288.309C3.882.692 1.496 2.518.917 5.127.64 6.412.61 7.837.661 9.143c.074 1.874.088 3.745.26 5.611.118 1.24.325 2.47.62 3.68.55 2.237 2.777 4.098 4.96 4.857 2.336.792 4.849.923 7.256.38.265-.061.527-.132.786-.213.585-.184 1.27-.39 1.774-.753a.057.057 0 0 0 .023-.043v-1.809a.052.052 0 0 0-.02-.041.053.053 0 0 0-.046-.01 20.282 20.282 0 0 1-4.709.545c-2.73 0-3.463-1.284-3.674-1.818a5.593 5.593 0 0 1-.319-1.433.053.053 0 0 1 .066-.054c1.517.363 3.072.546 4.632.546.376 0 .75 0 1.125-.01 1.57-.044 3.224-.124 4.768-.422.038-.008.077-.015.11-.024 2.435-.464 4.753-1.92 4.989-5.604.008-.145.03-1.52.03-1.67.002-.512.167-3.63-.024-5.545zm-3.748 9.195h-2.561V8.29c0-1.309-.55-1.976-1.67-1.976-1.23 0-1.846.79-1.846 2.35v3.403h-2.546V8.663c0-1.56-.617-2.35-1.848-2.35-1.112 0-1.668.668-1.67 1.977v6.218H4.822V8.102c0-1.31.337-2.35 1.011-3.12.696-.77 1.608-1.164 2.74-1.164 1.311 0 2.302.5 2.962 1.498l.638 1.06.638-1.06c.66-.999 1.65-1.498 2.96-1.498 1.13 0 2.043.395 2.74 1.164.675.77 1.012 1.81 1.012 3.12z"/>
        </svg>
        <span class="sr-only">Mastodon (abre en nueva pestaña)</span>
      </a>

      <a
        href="https://bsky.app/profile/lopublico.es"
        class="nav-social-link"
        target="_blank"
        rel="noopener"
        title="Bluesky (@lopublico.es)"
        aria-label="Bluesky (@lopublico.es)"
      >
        <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
          <path d="M5.202 2.857C7.954 4.922 10.913 9.11 12 11.358c1.087-2.247 4.046-6.436 6.798-8.501C20.783 1.366 24 .213 24 3.883c0 .732-.42 6.156-.667 7.037-.856 3.061-3.978 3.842-6.755 3.37 4.854.826 6.089 3.562 3.422 6.299-5.065 5.196-7.28-1.304-7.847-2.97-.104-.305-.152-.448-.153-.327 0-.121-.05.022-.153.327-.568 1.666-2.782 8.166-7.847 2.97-2.667-2.737-1.432-5.473 3.422-6.3-2.777.473-5.899-.308-6.755-3.369C.42 10.04 0 4.615 0 3.883c0-3.67 3.217-2.517 5.202-1.026"/>
        </svg>
        <span class="sr-only">Bluesky (abre en nueva pestaña)</span>
      </a>
    </div>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: 0;
    margin: 0;
    height: 44px;
    position: relative;
    width: 100%;
    box-sizing: border-box;
  }

  /* ── Minimal editorial navigation ─────────────────────────────────────── */
  .site-nav {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    background: transparent;
    padding: 0;
    border: none;
  }

  .nav-links {
    display: inline-flex;
    align-items: center;
    gap: 22px;
  }

  .nav-link {
    position: relative;
    padding: 4px 0;
    font-family: var(--font-sans);
    font-size: 13.5px;
    font-weight: 450;
    text-decoration: none;
    color: var(--muted, #6f6f6f);
    transition: color 140ms ease;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--fg, #000000);
  }

  .nav-link--active {
    color: var(--fg, #000000);
    font-weight: 550;
  }

  .nav-active-line {
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 1.5px;
    background: #000000;
    border-radius: 1px;
  }

  /* ── Separator between main nav and external socials ─────────────────── */
  .nav-separator {
    display: block;
    width: 1px;
    height: 13px;
    background: var(--line, #e5e5e5);
    flex-shrink: 0;
  }

  /* ── Social icons ────────────────────────────────────────────────────── */
  .nav-social {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .nav-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    color: var(--muted, #6f6f6f);
    border-radius: 4px;
    text-decoration: none;
    transition: color 140ms ease, opacity 140ms ease;
    line-height: 1;
  }

  .nav-social-link:hover {
    color: var(--fg, #000000);
  }

  .nav-social-link:focus-visible {
    outline: 2px solid var(--fg, #000000);
    outline-offset: 2px;
  }

  .nav-social-link svg {
    display: block;
    width: 15px;
    height: 15px;
  }

  /* ── Responsive ───────────────────────────────────────────────────────── */
  @media (max-width: 680px) {
    .site-header {
      height: auto;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px 20px;
      padding: 0;
    }

    .site-nav {
      gap: 14px;
      width: auto;
    }

    .nav-links {
      gap: 16px;
    }

    .nav-link {
      padding: 4px 0;
      font-size: 13px;
    }

    .nav-social {
      gap: 6px;
    }

    .nav-social-link {
      width: 24px;
      height: 24px;
    }
  }
</style>
