---
import Marca from './Marca.astro';

interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;

const navLinks = [
  { href: '/',      label: 'Inicio' },
  { href: '/datos',  label: 'Datos' },
  { href: '/about',  label: 'About' },
];
---

<header class="site-header">
  <Marca variant="header" href="/" />

  <nav class="site-nav" aria-label="Navegación principal">
    {navLinks.map(link => {
      const isActive = currentPath === link.href;
      return (
        <a
          href={link.href}
          class={`nav-link${isActive ? ' nav-link--active' : ''}`}
        >
          {link.label}
          {isActive && <span class="nav-active-line" transition:name="nav-active-line" />}
        </a>
      );
    })}
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: 0;
    margin: 0;
    height: 44px;
    position: relative;
    width: 100%;
    box-sizing: border-box;
  }

  /* ── Minimal editorial navigation (no bulky toggles) ─────────────────── */
  .site-nav {
    display: inline-flex;
    align-items: center;
    gap: 24px;
    background: transparent;
    padding: 0;
    border: none;
  }

  .nav-link {
    position: relative;
    padding: 4px 0;
    font-family: var(--font-sans);
    font-size: 13.5px;
    font-weight: 450;
    text-decoration: none;
    color: var(--muted, #6f6f6f);
    transition: color 140ms ease;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--fg, #000000);
  }

  .nav-link--active {
    color: var(--fg, #000000);
    font-weight: 550;
  }

  .nav-active-line {
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 1.5px;
    background: #000000;
    border-radius: 1px;
  }

  /* ── Responsive ───────────────────────────────────────────────────────── */
  @media (max-width: 680px) {
    .site-header {
      height: auto;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px 20px;
      padding: 0;
    }

    .site-nav {
      gap: 18px;
      width: auto;
    }

    .nav-link {
      padding: 4px 0;
      font-size: 13px;
    }
  }
</style>
