---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getEntradasBlog } from '../data/blog';

// El apartado Blog solo se genera si hay entradas de avelrom.es etiquetadas «lopublico» (ver src/data/blog.ts)
export async function getStaticPaths() {
  const entradas = await getEntradasBlog();
  return entradas.length ? [{ params: { blog: 'blog' }, props: { entradas } }] : [];
}
const { entradas } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout
  title="Lo público — Blog"
  description="Problemas de transparencia y datos abiertos que han ido apareciendo al construir los proyectos de Lo público."
  hideNotice={true}
>
  <div class="pantalla">
    <div class="zona-pagina">
      <SiteHeader currentPath="/blog" />

      <main class="contenido-pagina" id="contenido-principal" tabindex="-1">
        <h1 class="sr-only">Lo público — Blog</h1>
        <p class="blog-intro">
          Al construir estos proyectos han ido apareciendo fallos de transparencia: datos que no se publican en abierto, formatos imposibles de reutilizar, verificaciones que no existen.
        </p>

        <ul class="blog-lista">
          {entradas.map((e) => (
            <li>
              <a href={e.url} target="_blank" rel="noopener noreferrer" class="blog-entrada">
                <time class="blog-fecha" datetime={e.fecha.toISOString().slice(0, 10)}>{fmt(e.fecha)}</time>
                <span class="blog-titulo">{e.titulo}<span class="sr-only"> (abre en nueva pestaña)</span></span>
                {e.descripcion && <span class="blog-desc">{e.descripcion}</span>}
                <svg class="blog-flecha" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7H7M17 7V17" /></svg>
              </a>
            </li>
          ))}
        </ul>
      </main>
    </div>

    <!-- Footer abajo del todo de borde a borde de la ventana -->
    <footer class="pie-ventana">
      <div class="pie-col-izq">
        <a rel="me" href="https://masto.es/@lopublico.es@bsky.brid.gy" target="_blank" title="@lopublico en Mastodon">Mastodon<span class="sr-only"> (abre en nueva pestaña)</span></a> · <a href="https://bsky.app/profile/lopublico.es" target="_blank" rel="noopener" title="@lopublico.es en Bluesky">Bluesky<span class="sr-only"> (abre en nueva pestaña)</span></a>
      </div>
      <div class="pie-col-centro">
        Por <a href="https://avelrom.es/about/" target="_blank" rel="noopener" class="autor-subrayado">avelrom<span class="sr-only"> (abre en nueva pestaña)</span></a> · <a href="https://creativecommons.org/publicdomain/zero/1.0/deed.es" target="_blank" rel="noopener license">CC0 1.0<span class="sr-only"> (abre en nueva pestaña)</span></a>
      </div>
      <div class="pie-col-der">
        Obras del <a href="https://www.museodelprado.es/" target="_blank" rel="noopener">Museo Nacional del Prado<span class="sr-only"> (abre en nueva pestaña)</span></a>
      </div>
    </footer>
  </div>
</Layout>

<style>
  /* ── Pantalla completa con header fijo a la misma altura en todas las páginas ── */
  .pantalla {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    position: relative;
    width: 100%;
    box-sizing: border-box;
    overflow-x: hidden;
  }

  .zona-pagina {
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding: clamp(80px, calc(50vh - 190px), 300px) 32px 80px;
    box-sizing: border-box;
  }

  .contenido-pagina {
    margin-top: 24px;
    width: 100%;
  }

  .datos-intro {
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.6;
    color: #4b4b4b;
    margin: 0 0 24px;
    max-width: 720px;
  }

  .blog-intro {
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.6;
    color: #4b4b4b;
    margin: 0 0 24px;
    max-width: 720px;
  }

  .blog-lista { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line, #e5e5e5); }

  .blog-entrada {
    position: relative;
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) auto;
    column-gap: 20px;
    row-gap: 4px;
    align-items: baseline;
    padding: 16px 0;
    border-bottom: 1px solid var(--line, #e5e5e5);
    text-decoration: none;
    color: inherit;
  }

  .blog-fecha {
    grid-row: 1 / span 2;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.01em;
    color: var(--muted, #6f6f6f);
  }

  .blog-titulo {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.35;
    color: var(--fg, #000);
  }

  .blog-desc {
    grid-column: 2;
    font-family: var(--font-sans);
    font-size: 12.5px;
    line-height: 1.55;
    color: #4b4b4b;
  }

  .blog-flecha {
    grid-column: 3;
    grid-row: 1;
    color: var(--muted-2, #a3a3a3);
    transition: color 120ms ease, transform 120ms ease;
  }

  .blog-entrada:hover .blog-titulo { text-decoration: underline; text-underline-offset: 3px; }
  .blog-entrada:hover .blog-flecha { color: var(--fg, #000); transform: translate(1px, -1px); }

  .pie-ventana {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 16px 32px 24px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.02em;
    color: var(--muted-2, #a3a3a3);
    box-sizing: border-box;
    white-space: nowrap;
    border: none;
    z-index: 10;
  }

  .pie-col-izq {
    /* Mantiene centrada la columna del medio equilibrando con la derecha */
  }

  .pie-col-centro {
    justify-self: center;
    white-space: nowrap;
  }

  .pie-col-der {
    justify-self: end;
    white-space: nowrap;
  }

  .pie-ventana .autor-subrayado {
    color: #000000;
    font-weight: 550;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .pie-ventana a {
    color: inherit;
    transition: color 120ms;
  }

  .pie-ventana a:hover {
    color: var(--fg, #000000);
  }

  @media (max-width: 768px) {
    .pantalla { min-height: 100vh; justify-content: flex-start; padding: 0; }
    .zona-pagina { padding: 24px 20px 48px; }
    .contenido-pagina { margin-top: 20px; min-height: auto; }

    .blog-entrada { grid-template-columns: minmax(0, 1fr) auto; }
    .blog-fecha { grid-column: 1 / -1; grid-row: auto; margin-bottom: 2px; }
    .blog-desc { grid-column: 1; }

    .pie-ventana {
      position: static;
      display: flex;
      flex-direction: column;
      gap: 8px;
      align-items: center;
      text-align: center;
      white-space: normal;
      padding: 24px 20px 32px;
      margin-top: auto;
    }
    .pie-col-izq { display: block; }
    .pie-col-der { justify-self: center; }
  }
</style>
