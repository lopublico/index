---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';

const datasets = [
  {
    id: 'sal-de-ahi',
    titulo: 'Presencia de instituciones públicas y políticos españoles en redes sociales (Twitter/X, Bluesky, Mastodon)',
    descripcion:
      'Censo de cuentas oficiales en Twitter/X de ministerios, comunidades autónomas, ayuntamientos, empresas públicas y Cortes Generales vs alternativas en el Fediverso.',
    doi: '10.5281/zenodo.22229212',
    zenodoUrl: 'https://zenodo.org/records/22229212',
    formatos: ['CSV', 'JSON', 'XLSX'],
    estado: 'disponible',
  },
  {
    id: 'parlamentarios',
    titulo: 'Declaración de bienes y rentas de los miembros del Gobierno, Congreso y Senado',
    descripcion:
      'Datos personales, patrimoniales e institucionales de los 634 miembros de las Cortes Generales y Gobierno (XV Legislatura): inmuebles, vehículos, deuda y rentas.',
    doi: '10.5281/zenodo.21944946',
    zenodoUrl: 'https://zenodo.org/records/21944946',
    formatos: ['XLSX', 'SQLite'],
    estado: 'disponible',
  },
];
---

<Layout
  title="Lo público — Datos"
  description="Conjuntos de datos abiertos de Lo público depositados en Zenodo con DOI persistente y licencia de dominio público (CC0 1.0)."
  hideNotice={true}
>
  <div class="pantalla">
    <div class="zona-pagina">
      <SiteHeader currentPath="/datos" />

      <main class="contenido-pagina" id="contenido-principal" tabindex="-1">
        <h1 class="sr-only">Lo público — Conjuntos de datos abiertos</h1>
        <p class="datos-intro">
          Conjuntos de datos analizados y estructurados por Lo público. Toda la información procede de fuentes oficiales y está depositada en el repositorio europeo Zenodo con identificador persistente (DOI) y <strong>licencia de dominio público</strong> (CC0 1.0) para su descarga, auditoría y libre reutilización. No es obligatorio, pero agradecemos que cites el DOI del conjunto que uses.
        </p>

        <div class="radix-grid">
          {datasets.map((d) => (
            <article class="radix-card">
              <div class="radix-card-top">
                <h2 class="radix-proyecto">{d.titulo}</h2>
                {d.estado === 'proximo' ? (
                  <span class="radix-badge-proximo">En preparación</span>
                ) : (
                  <a
                    href={d.zenodoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="radix-doi"
                    title="Ver registro en Zenodo"
                  >
                    <span>{d.doi}</span>
                    <span class="sr-only"> (abre en una nueva pestaña)</span>
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M7 17L17 7H7M17 7V17" />
                    </svg>
                  </a>
                )}
              </div>

              <p class="radix-desc">{d.descripcion}</p>

              <div class="radix-card-pie">
                <div class="radix-tags">
                  {d.formatos.map((fmt) => (
                    <span class="radix-tag">{fmt}</span>
                  ))}
                </div>

                <div class="radix-accion">
                  {d.estado !== 'proximo' ? (
                    <a
                      href={d.zenodoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="radix-btn"
                    >
                      <span>Descarga desde Zenodo</span>
                      <span class="sr-only"> (abre en una nueva pestaña)</span>
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M7 17L17 7H7M17 7V17" />
                      </svg>
                    </a>
                  ) : (
                    <span class="radix-btn radix-btn--muted">Próximamente</span>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </main>
    </div>

    <!-- Footer abajo del todo de borde a borde de la ventana -->
    <footer class="pie-ventana">
      <div class="pie-col-izq">
        <a rel="me" href="https://masto.es/@lopublico.es@bsky.brid.gy" target="_blank" title="@lopublico en Mastodon">Mastodon<span class="sr-only"> (abre en nueva pestaña)</span></a> · <a href="https://bsky.app/profile/lopublico.es" target="_blank" rel="noopener" title="@lopublico.es en Bluesky">Bluesky<span class="sr-only"> (abre en nueva pestaña)</span></a>
      </div>
      <div class="pie-col-centro">
        Por <a href="https://avelrom.es/about/" target="_blank" rel="noopener" class="autor-subrayado">avelrom<span class="sr-only"> (abre en nueva pestaña)</span></a> · <a href="https://creativecommons.org/publicdomain/zero/1.0/deed.es" target="_blank" rel="noopener license">CC0 1.0<span class="sr-only"> (abre en nueva pestaña)</span></a>
      </div>
      <div class="pie-col-der">
        Obras del <a href="https://www.museodelprado.es/" target="_blank" rel="noopener">Museo Nacional del Prado<span class="sr-only"> (abre en nueva pestaña)</span></a>
      </div>
    </footer>
  </div>
</Layout>

<style>
  /* ── Pantalla completa con header fijo a la misma altura en todas las páginas ── */
  .pantalla {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    position: relative;
    width: 100%;
    box-sizing: border-box;
    overflow-x: hidden;
  }

  .zona-pagina {
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding: clamp(80px, calc(50vh - 190px), 300px) 32px 80px;
    box-sizing: border-box;
  }

  .contenido-pagina {
    margin-top: 24px;
    width: 100%;
  }

  .datos-intro {
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.6;
    color: #4b4b4b;
    margin: 0 0 24px;
    max-width: 720px;
  }

  /* ── Grid Radix sobrio de 2 columnas ──────────────────────────────────── */
  .radix-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    width: 100%;
    box-sizing: border-box;
  }

  .radix-card {
    background: #ffffff;
    border: 1px solid var(--line, #e5e5e5);
    border-radius: 10px;
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 12px;
    transition: border-color 140ms ease;
    box-sizing: border-box;
  }

  .radix-card:hover {
    border-color: #c4c4c4;
  }

  .radix-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .radix-proyecto {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.35;
    margin: 0;
    color: var(--fg, #000000);
  }

  .radix-doi {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.01em;
    color: var(--muted, #6f6f6f);
    text-decoration: none;
    flex-shrink: 0;
    margin-top: 2px;
    transition: color 120ms ease;
  }

  .radix-doi:hover {
    color: var(--fg, #000000);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .radix-badge-proximo {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.04em;
    color: var(--muted-2, #888888);
    background: #f7f7f6;
    border: 1px solid var(--line, #e5e5e5);
    border-radius: 4px;
    padding: 1px 5px;
  }

  .radix-desc {
    font-family: var(--font-sans);
    font-size: 12.5px;
    line-height: 1.55;
    color: #4b4b4b;
    margin: 0;
  }

  .radix-card-pie {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding-top: 10px;
    border-top: 1px solid #f2f2f1;
    flex-wrap: wrap;
  }

  .radix-tags {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
  }

  .radix-tag {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.03em;
    padding: 3px 8px;
    border-radius: 5px;
    background: #f5f5f4;
    border: 1px solid var(--line, #e5e5e5);
    color: #404040;
  }

  .radix-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 9px;
    border-radius: 5px;
    background: #ffffff;
    border: 1px solid var(--line, #e5e5e5);
    color: var(--fg, #000000);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    text-decoration: none;
    transition: background 120ms ease, border-color 120ms ease;
  }

  .radix-btn:hover {
    background: #f7f7f6;
    border-color: #d0d0d0;
  }

  .radix-btn--muted {
    background: #fafaf9;
    border-color: #eeeeec;
    color: var(--muted-2, #888888);
    cursor: not-allowed;
  }

  /* ── Footer abajo del todo de borde a borde de la ventana ─────────────── */
  .pie-ventana {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 16px 32px 24px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.02em;
    color: var(--muted-2, #a3a3a3);
    box-sizing: border-box;
    white-space: nowrap;
    border: none;
    z-index: 10;
  }

  .pie-col-izq {
    /* Mantiene centrada la columna del medio equilibrando con la derecha */
  }

  .pie-col-centro {
    justify-self: center;
    white-space: nowrap;
  }

  .pie-col-der {
    justify-self: end;
    white-space: nowrap;
  }

  .pie-ventana .autor-subrayado {
    color: #000000;
    font-weight: 550;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .pie-ventana a {
    color: inherit;
    transition: color 120ms;
  }

  .pie-ventana a:hover {
    color: var(--fg, #000000);
  }

  /* ── Responsive ───────────────────────────────────────────────────────── */
  /* En pantallas estrechas el botón va siempre debajo de los formatos, en todas las tarjetas */
  @media (max-width: 520px) {
    .radix-card-pie {
      flex-direction: column;
      align-items: stretch;
    }

    .radix-accion .radix-btn {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 768px) {
    .pantalla {
      min-height: 100vh;
      justify-content: flex-start;
      padding: 0;
    }

    .zona-pagina {
      padding: 24px 20px 48px;
    }

    .contenido-pagina {
      margin-top: 20px;
      min-height: auto;
    }

    .radix-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .pie-ventana {
      position: static;
      display: flex;
      flex-direction: column;
      gap: 8px;
      align-items: center;
      text-align: center;
      white-space: normal;
      padding: 24px 20px 32px;
      margin-top: auto;
    }

    .pie-col-izq {
      display: block;
    }

    .pie-col-der {
      justify-self: center;
    }
  }
</style>
