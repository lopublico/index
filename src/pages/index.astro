  @keyframes modal-entra {
    from { opacity: 0; transform: translateY(8px) scale(0.98); }
    to   { opacity: 1; transform: none; }
  }

  @keyframes modal-fade {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* ── Responsive ───────────────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .pantalla {
      min-height: 100vh;
      justify-content: flex-start;
      padding: 0;
    }

    .zona-pagina {
      padding: 24px 20px 0;
    }

    .contenido-pagina {
      margin-top: 24px;
      min-height: auto;
    }

    .carrusel-fila {
      flex-direction: column;
      overflow-x: visible;
      scroll-snap-type: none;
      gap: 16px;
      padding-top: 0;
      padding-bottom: 8px;
    }

    .tarjeta {
      flex: none;
      width: 100%;
      min-width: 0;
      aspect-ratio: 16 / 10;
    }

    .tarjeta-pin {
      top: 14px;
      left: 14px;
      right: auto;
    }

    .tarjeta-texto {
      left: 16px;
      right: 16px;
      bottom: 16px;
    }

    .tarjeta-titulo {
      font-size: 16px;
    }

    .tarjeta-subtitulo {
      font-size: 14px;
      line-height: 1.4;
    }

    .tarjeta-btn-info {
      top: 14px;
      right: 14px;
      bottom: auto;
      width: 28px;
      height: 28px;
    }

    .pie-ventana {
      position: static;
      display: flex;
      flex-direction: column;
      gap: 8px;
      align-items: center;
      text-align: center;
      white-space: normal;
      padding: 28px 20px 36px;
      margin-top: 20px;
    }

    .pie-col-izq {
      display: block;
    }

    .pie-col-der {
      justify-self: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carrusel-fila {
      scroll-behavior: auto;
    }
    .tarjeta, .tarjeta img, .tarjeta-btn-info, .icono-externo, .modal[open], .modal[open]::backdrop {
      transition: none;
      animation: none;
    }
  }
</style>

<script>
  let limpiarListeners: (() => void) | null = null;

  function iniciar() {
    if (limpiarListeners) {
      limpiarListeners();
      limpiarListeners = null;
    }

    const carrusel = document.querySelector<HTMLElement>('.carrusel-fila');
    if (!carrusel) return;

    // Estado de desplazamiento suave (smooth physics / lerp)
    let targetScroll = carrusel.scrollLeft;
    let currentScroll = carrusel.scrollLeft;
    let animando = false;
    let rafId: number | null = null;

    const getMaxScroll = () => Math.max(0, carrusel.scrollWidth - carrusel.clientWidth);

    const animar = () => {
      const diff = targetScroll - currentScroll;
      // Umbral de parada imperceptible (< 0.4px)
      if (Math.abs(diff) < 0.4) {
        currentScroll = targetScroll;
        carrusel.scrollLeft = targetScroll;
        animando = false;
        rafId = null;
        return;
      }

      // Factor de suavizado exponencial (0.16 proporciona ~250ms de desaceleración sedosa)
      currentScroll += diff * 0.16;
      carrusel.scrollLeft = currentScroll;
      rafId = requestAnimationFrame(animar);
    };

    const desplazarHacia = (nuevoTarget: number, suave: boolean = true) => {
      const maxScroll = getMaxScroll();
      targetScroll = Math.max(0, Math.min(maxScroll, nuevoTarget));

      if (!suave || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        if (rafId) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }
        animando = false;
        currentScroll = targetScroll;
        carrusel.scrollLeft = targetScroll;
        return;
      }

      if (!animando) {
        currentScroll = carrusel.scrollLeft;
        animando = true;
        rafId = requestAnimationFrame(animar);
      }
    };

    // Sincronización si el usuario interactúa de forma nativa o táctil
    const manejarScrollNativo = () => {
      if (!animando) {
        currentScroll = carrusel.scrollLeft;
        targetScroll = carrusel.scrollLeft;
      }
    };
    carrusel.addEventListener('scroll', manejarScrollNativo, { passive: true });

    // Ajustar límites si la ventana cambia de tamaño
    const manejarResize = () => {
      const max = getMaxScroll();
      if (targetScroll > max) targetScroll = max;
      if (currentScroll > max) currentScroll = max;
    };
    window.addEventListener('resize', manejarResize, { passive: true });

    // Conversión de scroll vertical y horizontal (ratón / trackpad) en toda la web a scroll horizontal suave
    const manejarWheel = (e: WheelEvent) => {
      // En móvil (≤ 768px) las tarjetas se apilan en vertical; el scroll es el natural de la página
      if (window.innerWidth <= 768) return;

      // Si hay un modal abierto, permitir scroll normal dentro del modal
      if (document.querySelector('dialog[open]')) return;

      // Normalizar deltaMode (0 = píxeles, 1 = líneas, 2 = páginas)
      let dy = e.deltaY;
      let dx = e.deltaX;
      if (e.deltaMode === 1) {
        dy *= 24;
        dx *= 24;
      } else if (e.deltaMode === 2) {
        dy *= window.innerHeight;
        dx *= window.innerWidth;
      }

      // Elegir el delta dominante entre vertical y horizontal
      const delta = Math.abs(dx) > Math.abs(dy) ? dx : dy;
      if (delta === 0) return;

      const maxScroll = getMaxScroll();
      if (maxScroll <= 0) return;

      // Evitar que la página intente desplazarse verticalmente mientras navegamos por el carrusel
      e.preventDefault();

      desplazarHacia(targetScroll + delta, true);
    };

    // Navegación con teclado en escritorio (flechas, AvPág/RePág, barra espaciadora, Inicio/Fin)
    const manejarKeydown = (e: KeyboardEvent) => {
      if (window.innerWidth <= 768) return;
      if (document.querySelector('dialog[open]')) return;

      const tag = (document.activeElement?.tagName || '').toLowerCase();
      if (tag === 'input' || tag === 'textarea' || tag === 'select') return;

      const paso = 280;

      if (e.key === 'ArrowRight' || e.key === 'ArrowDown' || e.key === 'PageDown' || (e.key === ' ' && !e.shiftKey)) {
        e.preventDefault();
        desplazarHacia(targetScroll + paso, true);
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp' || e.key === 'PageUp' || (e.key === ' ' && e.shiftKey)) {
        e.preventDefault();
        desplazarHacia(targetScroll - paso, true);
      } else if (e.key === 'Home') {
        e.preventDefault();
        desplazarHacia(0, true);
      } else if (e.key === 'End') {
        e.preventDefault();
        desplazarHacia(carrusel.scrollWidth, true);
      }
    };

    window.addEventListener('wheel', manejarWheel, { passive: false });
    window.addEventListener('keydown', manejarKeydown);

    limpiarListeners = () => {
      if (rafId) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
      animando = false;
      carrusel.removeEventListener('scroll', manejarScrollNativo);
      window.removeEventListener('resize', manejarResize);
      window.removeEventListener('wheel', manejarWheel);
      window.removeEventListener('keydown', manejarKeydown);
    };

    // Los botones de info abren el modal SIN navegar a la URL del proyecto
    document.querySelectorAll<HTMLButtonElement>('.tarjeta-btn-info').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const id = btn.dataset.abrir;
        if (id) {
          (document.getElementById(id) as HTMLDialogElement | null)?.showModal();
        }
      });
    });

    // Cerrar al hacer clic en el botón cerrar o fuera del modal
    document.querySelectorAll<HTMLDialogElement>('dialog.modal').forEach((dlg) => {
      dlg.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        if (t === dlg || t.closest('[data-cerrar]')) {
          dlg.close();
        }
      });
    });
  }

  // Ejecutar tanto en carga inicial como en transiciones de Astro
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', iniciar);
  } else {
    iniciar();
  }
  document.addEventListener('astro:page-load', iniciar);
</script>
