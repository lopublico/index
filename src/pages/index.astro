    margin: 0 0 22px;
  }

  .modal-pie {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 16px;
    border-top: 1px solid #f0f0f0;
  }

  .modal-accion {
    display: flex;
    align-items: center;
  }

  .modal-enlace {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border-radius: 999px;
    background: #000000;
    color: #ffffff;
    font-family: var(--font-sans);
    font-size: 12.5px;
    font-weight: 500;
    text-decoration: none;
    transition: background 150ms ease, transform 150ms ease;
