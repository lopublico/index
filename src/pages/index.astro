  .modal-enlace:hover {
    background: #242424;
    transform: translateY(-1px);
  }

  .modal-badge-proximo {
    display: inline-block;
    padding: 5px 12px;
    border-radius: 999px;
    background: #f5f5f5;
    font-family: var(--font-mono);
