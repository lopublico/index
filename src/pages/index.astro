---
import Layout from '../layouts/Layout.astro';
import LogoCarrusel from '../components/LogoCarrusel.astro';
---

<Layout title="Lo público — Próximamente" hideNotice={true}>
  <main>
    <LogoCarrusel size={72} />
    <h1>Lo público.</h1>
    <p class="subtitulo">La Administración en datos</p>
    <p class="estado">Próximamente</p>
  </main>
</Layout>

<style>
  main {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 24px;
  }

  h1 {
    font-size: clamp(32px, 5vw, 44px);
    font-weight: 600;
    letter-spacing: -0.03em;
    margin: 20px 0 6px;
  }

  .subtitulo {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(16px, 2.5vw, 20px);
    color: var(--muted);
  }

  .estado {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted-2);
    margin-top: 32px;
  }
</style>
