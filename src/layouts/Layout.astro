---
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import Seo from '@lopublico/ui/Seo.astro';
import AvisoMovil from '@lopublico/ui/AvisoMovil.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  hideNotice?: boolean;
}

const {
  title = 'Lo público',
  description = 'Herramientas para fiscalizar el sector público español: contratación, listas de espera, comunicación institucional y más.',
  image = '/og-horizontal.png',
  hideNotice = false,
} = Astro.props;

const siteBase = Astro.site?.toString().replace(/\/$/, '') ?? 'https://lopublico.es';
const ogImage  = image.startsWith('http') ? image : `${siteBase}${image}`;
const canonical = Astro.url.href;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Seo title={title} description={description} canonical={canonical} siteName="Lo público"
      imagenes={[{ url: ogImage, width: 1200, height: 630 }, { url: `${siteBase}/og-cuadrada.png`, width: 1080, height: 1080 }]} />


    <!-- Verificación Mastodon / Fediverso -->
    <link rel="me" href="https://masto.es/@lopublico.es@bsky.brid.gy" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-mono" />
    <ClientRouter />
  </head>
  <body>
    <a href="#contenido-principal" class="salto-contenido">Saltar al contenido principal</a>
    {!hideNotice && <AvisoMovil cerrable>Las plataformas de Lo Público muestran datos tabulares que pueden no verse bien en pantallas pequeñas. Se recomienda acceder desde un ordenador.</AvisoMovil>}
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff;
    --fg: #000000;
    --fg-2: #1a1a1a;
    --muted: #6f6f6f;
    --muted-2: #767676;
    --line: #e5e5e5;
    --line-strong: #d4d4d4;
    --hover-bg: #fafafa;

    /* --font-sans / --font-mono / --font-serif los define <Font> (astro:assets) */

    /* Shared layout constants */
    --page-max:     1320px;
    --page-pad:     48px;
    --page-pad-sm:  20px;
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-size: 14px;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    scrollbar-gutter: stable;
  }

  body {
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-sans);
    line-height: 1.5;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  a   { color: inherit; text-decoration: none; }
  img { display: block; max-width: 100%; }

  button {
    font-family: inherit;
    cursor: pointer;
    border: none;
    background: none;
    padding: 0;
  }

  /* ── Shared page container ───────────────────────────────────────────── */
  /* Used as class="page" on every <main>. Scoped styles must not redefine
     these properties — only add page-specific ones on top. */
  .page {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--page-pad);
    width: 100%;
    flex: 1;           /* pushes footer to bottom (body is flex-column) */
  }

  /* Sticky footer: belt-and-suspenders for <main> without .page */
  body > main { flex: 1; }

  @media (max-width: 600px) {
    .page { padding: 0 var(--page-pad-sm); }
  }


  /* ── Mobile notice ───────────────────────────────────────────────────── */
  :focus-visible {
    outline: 2px solid var(--fg, #000000);
    outline-offset: 2px;
  }

  /* ── Salto al contenido principal accesible ──────────────────────────── */
  .salto-contenido {
    position: fixed;
    top: -100px;
    left: 16px;
    z-index: 99999;
    padding: 10px 18px;
    background: #000000;
    color: #ffffff;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 550;
    border-radius: 8px;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    transition: top 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .salto-contenido:focus {
    top: 16px;
    outline: 2px solid #ffffff;
    outline-offset: 2px;
  }

  /* ── Screen readers only ──────────────────────────────────────────────── */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  /* ── Reduced motion ──────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
    [transition\:animate] { animation: none !important; }
  }
</style>
